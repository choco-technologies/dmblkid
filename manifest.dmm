# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/dmblkid/releases/download/vlatest/versions.dmm

# Module entry with version placeholder - expanded by $version-available
dmblkid https://github.com/choco-technologies/dmblkid/releases/download/v<version>/dmblkid-v<version>-<arch_name>.zip

# blkid - command line front end (services/blkid), built and released together
# with dmblkid
blkid https://github.com/choco-technologies/dmblkid/releases/download/v<version>/blkid-v<version>-<arch_name>.zip

# dmpart - partition table parser library (libs/dmpart), used by dmblkid and
# dmdevfs; built and released together with dmblkid
dmpart https://github.com/choco-technologies/dmblkid/releases/download/v<version>/dmpart-v<version>-<arch_name>.zip
